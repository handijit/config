{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Han Dijit Electron app: main, preload and shared",
  "extends": "./base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@main/*": ["${configDir}/src/main/*"],
      "@shared/*": ["${configDir}/src/shared/*"]
    }
  },
  "include": [
    "${configDir}/src/main",
    "${configDir}/src/preload",
    "${configDir}/src/shared"
  ]
}
